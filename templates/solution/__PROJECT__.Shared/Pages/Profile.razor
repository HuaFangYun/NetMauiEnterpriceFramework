@page "/profile"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject AuthService AuthService

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-0">
    <MudPaper Elevation="0" Class="dashboard-card">
        <div class="page-heading">
            <div>
                <div class="dashboard-kicker">Account</div>
                <h1>Profile</h1>
                <p>Your account information.</p>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" Style="font-size:48px;" />
        </div>

        @if (_user == null)
        {
            <MudAlert Severity="Severity.Info">Profile is not available.</MudAlert>
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6"><div class="profile-label">User ID</div><div class="profile-value">@_user.UserId</div></MudItem>
                <MudItem xs="12" md="6"><div class="profile-label">Full Name</div><div class="profile-value">@_user.FullName</div></MudItem>
                <MudItem xs="12" md="6"><div class="profile-label">Email</div><div class="profile-value">@_user.Email</div></MudItem>
                <MudItem xs="12" md="6"><div class="profile-label">Role</div><div class="profile-value">@_user.RoleId</div></MudItem>
                <MudItem xs="12" md="6"><div class="profile-label">Status</div><div class="profile-value">@(_user.IsActive ? "Active" : "Inactive")</div></MudItem>
            </MudGrid>
        }
    </MudPaper>
</MudContainer>

@code {
    private UserResponseDto? _user;

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthService.GetCurrentUserAsync();
    }
}
