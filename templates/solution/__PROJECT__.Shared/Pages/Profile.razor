@page "/profile"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject AuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

@if (_user == null)
{
    <MudAlert Severity="Severity.Info">Profile is not available.</MudAlert>
}
else
{
    <MudPaper Elevation="0" Class="profile-header-card">
        <div class="profile-identity">
            <div class="profile-avatar">@Initials</div>
            <div>
                <h1>@_user.FullName</h1>
                <div class="profile-role">@RoleName</div>
                <div class="d-flex align-items-center flex-wrap gap-2 mt-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Verified Account</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">ID: @_user.UserId</MudChip>
                </div>
            </div>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditProfileAsync">Edit Profile</MudButton>
    </MudPaper>

    <MudGrid Spacing="3" Class="mt-1">
        <MudItem xs="12" md="7">
            <MudPaper Elevation="0" Class="profile-panel">
                <div class="profile-panel-title">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Personal Details</MudText>
                </div>

                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="6">
                        <div class="profile-label">Email Address</div>
                        <div class="profile-value">@_user.Email</div>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="profile-label">Phone Number</div>
                        <div class="profile-value">@(_user.PhoneNumber ?? "-")</div>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="profile-label">Gender</div>
                        <div class="profile-value">@GenderName</div>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="profile-label">Role</div>
                        <div class="profile-value">@RoleName</div>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="profile-label">User ID</div>
                        <div class="profile-value">@_user.UserId</div>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="profile-label">Status</div>
                        <div class="profile-value">
                            <MudChip T="string" Size="Size.Small" Color="@(_user.IsActive ? Color.Success : Color.Default)">
                                @(_user.IsActive ? "Active" : "Inactive")
                            </MudChip>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Elevation="0" Class="profile-panel">
                <div class="profile-panel-title">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Account Security</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Lock" OnClick="TogglePasswordUpdate">Change Password</MudButton>
                </div>

                @if (_showPasswordUpdate)
                {
                    <div class="profile-password-panel">
                        @if (!string.IsNullOrWhiteSpace(_passwordError))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_passwordError</MudAlert>
                        }

                        <MudTextField T="string"
                                      Label="Current Password*"
                                      @bind-Value="_changePasswordModel.CurrentPassword"
                                      InputType="@(_showCurrentPassword ? InputType.Text : InputType.Password)"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Class="mb-2"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showCurrentPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@(() => _showCurrentPassword = !_showCurrentPassword)" />
                        <MudTextField T="string"
                                      Label="New Password*"
                                      @bind-Value="_changePasswordModel.NewPassword"
                                      InputType="@(_showNewPassword ? InputType.Text : InputType.Password)"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Class="mb-2"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showNewPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@(() => _showNewPassword = !_showNewPassword)" />
                        <MudTextField T="string"
                                      Label="New Password Confirm*"
                                      @bind-Value="_changePasswordModel.ConfirmNewPassword"
                                      InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Class="mb-2"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="@(() => _showConfirmPassword = !_showConfirmPassword)" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Disabled="@_passwordSaving"
                                   OnClick="UpdatePasswordAsync">
                            @(_passwordSaving ? "Updating..." : "Update Password")
                        </MudButton>
                    </div>
                }

                <div class="profile-security-block">
                    <div class="profile-info-row">
                        <div class="profile-security-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Password" Color="Color.Primary" />
                        </div>
                        <div>
                            <div class="profile-label">Password Status</div>
                            <div class="profile-value">Last updated: @(_user.LastPasswordChangeDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</div>
                        </div>
                    </div>
                </div>

                <div class="profile-security-block">
                    <div class="profile-info-row">
                        <div class="profile-security-icon">
                            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Primary" />
                        </div>
                        <div class="profile-access-content">
                            <div class="profile-label mb-2">Access Rights</div>
                            <div class="d-flex flex-column gap-2">
                                <MudSwitch T="bool" Value="_user.CanAddEdit" Disabled="true" Color="Color.Primary" Size="Size.Medium" Label="Add/Edit" />
                                <MudSwitch T="bool" Value="_user.CanDelete" Disabled="true" Color="Color.Primary" Size="Size.Medium" Label="Delete" />
                                <MudSwitch T="bool" Value="_user.CanReadOnly" Disabled="true" Color="Color.Primary" Size="Size.Medium" Label="ReadOnly" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="profile-security-block">
                    <div class="profile-info-row">
                        <div class="profile-security-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Devices" Color="Color.Primary" />
                        </div>
                        <div>
                            <div class="profile-label">Last Login</div>
                            <div class="profile-value">@_user.LastLoginDate.ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                    </div>
                </div>

                <div class="profile-security-block">
                    <div class="profile-info-row">
                        <div class="profile-security-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Router" Color="Color.Primary" />
                        </div>
                        <div>
                            <div class="profile-label">Last IP Access</div>
                            <div class="profile-value">@(_user.LastIpAddress ?? "-")</div>
                        </div>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Dashboard", href: "/dashboard"),
        new("Account", href: null),
        new("Profile", href: null, disabled: true),
    ];

    private UserResponseDto? _user;
    private readonly ChangePasswordDto _changePasswordModel = new();
    private bool _showPasswordUpdate;
    private bool _showCurrentPassword;
    private bool _showNewPassword;
    private bool _showConfirmPassword;
    private bool _passwordSaving;
    private string? _passwordError;

    private string Initials
    {
        get
        {
            var source = _user?.FullName ?? _user?.UserId;
            if (string.IsNullOrWhiteSpace(source))
            {
                return "?";
            }

            return string.Concat(source
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));
        }
    }

    private string RoleName => _user?.RoleName ?? _user?.RoleId ?? "-";

    private string GenderName => _user?.GenderId?.ToUpperInvariant() switch
    {
        "L" => "Laki-Laki",
        "P" => "Perempuan",
        _ => _user?.GenderId ?? "-",
    };

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthService.GetCurrentUserAsync();
    }

    private async Task EditProfileAsync()
    {
        if (_user == null)
        {
            return;
        }

        var parameters = new DialogParameters { ["User"] = _user };
        var dialog = await DialogService.ShowAsync<ProfileEditDialog>("Edit Profile", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: UserResponseDto updated })
        {
            _user = updated;
            StateHasChanged();
        }
    }

    private void TogglePasswordUpdate()
    {
        _showPasswordUpdate = !_showPasswordUpdate;
        _passwordError = null;

        if (!_showPasswordUpdate)
        {
            ResetPasswordFields();
        }
    }

    private async Task UpdatePasswordAsync()
    {
        _passwordError = null;

        if (string.IsNullOrWhiteSpace(_changePasswordModel.CurrentPassword)
            || string.IsNullOrWhiteSpace(_changePasswordModel.NewPassword)
            || string.IsNullOrWhiteSpace(_changePasswordModel.ConfirmNewPassword))
        {
            _passwordError = "All password fields are required.";
            return;
        }

        if (_changePasswordModel.NewPassword != _changePasswordModel.ConfirmNewPassword)
        {
            _passwordError = "New password and confirmation do not match.";
            return;
        }

        _passwordSaving = true;
        try
        {
            await AuthService.ChangePasswordAsync(_changePasswordModel);
            Snackbar.Add("Password changed successfully.", Severity.Success);
            _showPasswordUpdate = false;
            ResetPasswordFields();
            _user = await AuthService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            _passwordError = ex.Message;
        }
        finally
        {
            _passwordSaving = false;
        }
    }

    private void ResetPasswordFields()
    {
        _changePasswordModel.CurrentPassword = string.Empty;
        _changePasswordModel.NewPassword = string.Empty;
        _changePasswordModel.ConfirmNewPassword = string.Empty;
        _showCurrentPassword = false;
        _showNewPassword = false;
        _showConfirmPassword = false;
    }
}
