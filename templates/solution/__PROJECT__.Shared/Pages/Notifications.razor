@page "/notifications"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject NotificationApiService NotificationApi
@inject ISnackbar Snackbar

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-4" />

<div class="page-heading">
    <div>
        <h1>Notifications</h1>
        <p>All notifications for your account.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="MarkAllReadAsync">
            Mark All Read
        </MudButton>
    </div>
</div>

<MudPaper Elevation="0" Class="notification-page-panel">
    <MudTextField @bind-Value="_search"
                  @bind-Value:after="ApplyFilter"
                  Label="Search"
                  Placeholder="Search notifications..."
                  Variant="Variant.Outlined"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true"
                  Class="notification-search" />

    <MudTable Items="_filtered"
              Hover="true"
              Breakpoint="Breakpoint.Sm"
              Striped="true"
              Bordered="true"
              Class="mt-4">
        <HeaderContent>
            <MudTh>Notification</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Notification">
                <div class="d-flex align-start gap-2">
                    @if (!context.IsSeen)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.MarkEmailUnread" Color="Color.Primary" Size="Size.Small" Class="mt-1" />
                    }
                    <div>
                        <MudText Typo="Typo.body2" Style="@(context.IsSeen ? "font-weight:400;" : "font-weight:700;")">
                            @(context.ShortText ?? context.Type ?? "Notification")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.LongText</MudText>
                    </div>
                </div>
            </MudTd>
            <MudTd DataLabel="Date">@context.CreatedDate?.ToString("dd MMM yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsSeen ? Color.Default : Color.Primary)" Variant="Variant.Outlined">
                    @(context.IsSeen ? "Read" : "Unread")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Action">
                @if (!context.IsSeen)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => MarkReadAsync(context))">
                        Mark Read
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="notification-empty">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Color="Color.Error" Size="Size.Large" />
                <MudText Color="Color.Error">No notifications</MudText>
            </div>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Dashboard", href: "/dashboard"),
        new("Notifications", href: null, disabled: true),
    ];

    private List<NotificationDto> _notifications = new();
    private List<NotificationDto> _filtered = new();
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _notifications = await NotificationApi.GetRecentAsync(100);
            ApplyFilter();
        }
        catch
        {
            Snackbar.Add("Unable to load notifications.", Severity.Error);
        }
    }

    private void ApplyFilter()
    {
        var term = _search.Trim();
        _filtered = string.IsNullOrWhiteSpace(term)
            ? _notifications
            : _notifications
                .Where(n => (n.ShortText ?? n.LongText ?? string.Empty)
                    .Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private async Task MarkReadAsync(NotificationDto notification)
    {
        await NotificationApi.MarkSeenAsync(notification.Id);
        notification.IsSeen = true;
        ApplyFilter();
        Snackbar.Add("Notification marked as read.", Severity.Success);
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationApi.MarkAllSeenAsync();
        foreach (var notification in _notifications)
        {
            notification.IsSeen = true;
        }

        ApplyFilter();
        Snackbar.Add("All notifications marked as read.", Severity.Success);
    }
}
