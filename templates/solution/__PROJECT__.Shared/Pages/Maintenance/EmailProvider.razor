@page "/dashboard/maintenance/email-provider"
@layout AuthenticatedLayout
@using __PROJECT__.Application.DTOs.Email
@attribute [Authorize]
@attribute [Authorize(Roles = "00")]
@inject EmailProviderApiService EmailProviderApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<MudPaper Elevation="0" Class="dashboard-card">
    <div class="page-heading">
        <div>
            <div class="dashboard-kicker">Setting</div>
            <h1>Email Provider</h1>
            <p>Configure SMTP or Gmail delivery for password reset and notification emails.</p>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddAsync">
            Add Provider
        </MudButton>
    </div>

    <MudTable T="EmailProviderDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="Search"
                          Placeholder="Search provider..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="user-search" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="text-align:center;">Actions</MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="providertype">Type</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="providername">Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="fromemail">From Email</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="priority">Priority</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="isactive">Active</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="EmailProviderDto" SortLabel="lasttestedat">Last Test</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Actions" Style="text-align:center; white-space:nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.Send"
                               Size="Size.Small"
                               Color="Color.Success"
                               Disabled="@_testingId.HasValue"
                               OnClick="@(_ => TestAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="@(_ => OpenEditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(_ => DeleteAsync(context))" />
            </MudTd>
            <MudTd DataLabel="Type">@context.ProviderType</MudTd>
            <MudTd DataLabel="Name">@context.ProviderName</MudTd>
            <MudTd DataLabel="From Email">@context.FromEmail</MudTd>
            <MudTd DataLabel="Priority">@context.Priority</MudTd>
            <MudTd DataLabel="Active">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Last Test">
                @if (context.LastTestedAt.HasValue)
                {
                    <div>@context.LastTestStatus</div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.LastTestedAt.Value.ToString("yyyy-MM-dd HH:mm")</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Not tested</MudText>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No email provider configured.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Dashboard", href: "/dashboard"),
        new("Setting", href: null),
        new("Email Provider", href: null, disabled: true),
    ];

    private MudTable<EmailProviderDto>? _table;
    private string? _search;
    private int? _testingId;

    private async Task<TableData<EmailProviderDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await EmailProviderApi.GetListAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        });

        return new TableData<EmailProviderDto>
        {
            Items = response.Data,
            TotalItems = response.Pagination.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenAddAsync()
    {
        var parameters = new DialogParameters<EmailProviderDialog>
        {
            { x => x.Provider, new EmailProviderDto() },
        };
        var dialog = await DialogService.ShowAsync<EmailProviderDialog>("Add Email Provider", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditAsync(EmailProviderDto provider)
    {
        var parameters = new DialogParameters<EmailProviderDialog>
        {
            { x => x.Provider, provider },
        };
        var dialog = await DialogService.ShowAsync<EmailProviderDialog>("Edit Email Provider", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task TestAsync(EmailProviderDto provider)
    {
        _testingId = provider.Id;
        try
        {
            var result = await EmailProviderApi.TestAsync(provider.Id, null);
            Snackbar.Add(result.Message ?? (result.Success ? "Test email sent." : "Test failed."),
                result.Success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _testingId = null;
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(EmailProviderDto provider)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Delete Email Provider",
            ["Message"] = $"Delete provider '{provider.ProviderName ?? provider.ProviderType}'?",
            ["ConfirmText"] = "Delete",
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Email Provider", parameters);
        if (await dialog.Result is not { Canceled: false })
        {
            return;
        }

        var result = await EmailProviderApi.DeleteAsync(provider.Id);
        Snackbar.Add(result.Message ?? "Email provider deleted.", result.Success ? Severity.Success : Severity.Error);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }
}
