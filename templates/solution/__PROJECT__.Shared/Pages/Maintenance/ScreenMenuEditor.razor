@page "/dashboard/maintenance/screen-menu-editor"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject ScreenMenuApiService ScreenMenuApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="dashboard-card">
    <div class="page-heading">
        <div>
            <div class="dashboard-kicker">Maintenance</div>
            <h1>Screen Menu</h1>
            <p>Manage screens with child modal/URL and import process metadata.</p>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(_ => OpenAddAsync())">Add Screen</MudButton>
    </div>

    <div class="table-toolbar">
        <MudTextField @bind-Value="_search"
                      Placeholder="Search screen..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(_ => ReloadAsync())">Search</MudButton>
    </div>

    <MudTable T="ScreenMenuListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              Elevation="0">
        <HeaderContent>
            <MudTh>Screen ID</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Child</MudTh>
            <MudTh>Import</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Screen ID">@context.Id</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Child">@context.ScreenMenuChildId</MudTd>
            <MudTd DataLabel="Import">@context.ScreenMenuImportExcelProcessId</MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Inactive</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(_ => OpenEditAsync(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No screen menus.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<ScreenMenuListItemDto>? _table;
    private string? _search;

    private async Task<TableData<ScreenMenuListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await ScreenMenuApi.GetListAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        });

        return new TableData<ScreenMenuListItemDto> { Items = response.Data, TotalItems = response.TotalCount };
    }

    private async Task ReloadAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenAddAsync()
    {
        var dialog = await DialogService.ShowAsync<ScreenMenuEditorDialog>("Add Screen Menu");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditAsync(ScreenMenuListItemDto item)
    {
        var model = await ScreenMenuApi.GetAsync(item.Id);
        if (model == null)
        {
            Snackbar.Add("Screen menu not found.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["Screen"] = model };
        var dialog = await DialogService.ShowAsync<ScreenMenuEditorDialog>("Edit Screen Menu", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }
}
