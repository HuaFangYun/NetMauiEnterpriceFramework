@page "/dashboard/maintenance/role-approval"
@layout AuthenticatedLayout
@attribute [Authorize]
@attribute [Authorize(Roles = "00")]
@inject ApprovalApiService ApprovalApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">Approval</div>
        <h1>Role Approval</h1>
        <p>Review user-role assignment requests.</p>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="ApproveAll">Approve All</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DoNotDisturb" OnClick="RejectAll">Reject All</MudButton>
    </div>
</div>

<MudPaper Elevation="0" Class="dashboard-card">
    <MudTable T="RoleApprovalListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="Search"
                          Placeholder="Search request..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="approval-search" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="fullname">User</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="groupname">Group</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="canadded">Add/Edit</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="candelete">Delete</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="canreadonly">Read Only</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RoleApprovalListItemDto" SortLabel="approvaltype">Type</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:center;">Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="User">@context.FullName <span class="text-muted">(@context.UserId)</span></MudTd>
            <MudTd DataLabel="Group">@(context.GroupName ?? context.GroupId)</MudTd>
            <MudTd DataLabel="Add/Edit">@(context.CanAddEdit ? "Yes" : "No")</MudTd>
            <MudTd DataLabel="Delete">@(context.CanDelete ? "Yes" : "No")</MudTd>
            <MudTd DataLabel="Read Only">@(context.CanReadOnly ? "Yes" : "No")</MudTd>
            <MudTd DataLabel="Type">@context.ApprovalType</MudTd>
            <MudTd DataLabel="Action" Style="text-align:center;">
                <MudRadioGroup @bind-Value="context.SelectedAction" Class="approval-radios">
                    <MudRadio T="int" Value="1" Color="Color.Primary">Approve</MudRadio>
                    <MudRadio T="int" Value="2" Color="Color.Default">Pending</MudRadio>
                    <MudRadio T="int" Value="0" Color="Color.Error">Reject</MudRadio>
                </MudRadioGroup>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No pending role requests.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>

    <div class="d-flex justify-center mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Gavel" Disabled="@_submitting" OnClick="SubmitApprovalsAsync">
            @(_submitting ? "Submitting..." : "Submit")
        </MudButton>
    </div>
</MudPaper>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Dashboard", href: "/dashboard"),
        new("Maintenance", href: null),
        new("Role Approval", href: null, disabled: true),
    ];

    private MudTable<RoleApprovalListItemDto>? _table;
    private List<RoleApprovalListItemDto> _currentItems = new();
    private string? _search;
    private bool _submitting;

    private async Task<TableData<RoleApprovalListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await ApprovalApi.GetPendingRolesAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        });

        _currentItems = response.Data ?? new List<RoleApprovalListItemDto>();
        foreach (var item in _currentItems)
        {
            item.SelectedAction = 2;
        }

        return new TableData<RoleApprovalListItemDto>
        {
            Items = _currentItems,
            TotalItems = response.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private void ApproveAll()
    {
        foreach (var item in _currentItems)
        {
            item.SelectedAction = 1;
        }
        StateHasChanged();
    }

    private void RejectAll()
    {
        foreach (var item in _currentItems)
        {
            item.SelectedAction = 0;
        }
        StateHasChanged();
    }

    private async Task SubmitApprovalsAsync()
    {
        var approveIds = _currentItems.Where(x => x.SelectedAction == 1).Select(x => x.Id).ToList();
        var rejectIds = _currentItems.Where(x => x.SelectedAction == 0).Select(x => x.Id).ToList();

        if (approveIds.Count == 0 && rejectIds.Count == 0)
        {
            Snackbar.Add("No approvals or rejections selected.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Title"] = "Confirm Submission",
            ["Message"] = $"Approve {approveIds.Count} item(s) and reject {rejectIds.Count} item(s)?",
            ["ConfirmText"] = "Submit",
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Submission", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        _submitting = true;
        try
        {
            var failed = 0;
            foreach (var id in approveIds)
            {
                var response = await ApprovalApi.ApproveRoleAsync(id);
                if (!response.Success)
                {
                    failed++;
                }
            }

            foreach (var id in rejectIds)
            {
                var response = await ApprovalApi.RejectRoleAsync(id);
                if (!response.Success)
                {
                    failed++;
                }
            }

            Snackbar.Add(
                failed == 0 ? "Approval processed successfully." : $"{failed} request(s) failed.",
                failed == 0 ? Severity.Success : Severity.Error);
            await _table!.ReloadServerData();
        }
        finally
        {
            _submitting = false;
        }
    }
}
