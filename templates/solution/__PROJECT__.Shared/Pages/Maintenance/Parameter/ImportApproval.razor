@page "/dashboard/maintenance/import-approval"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject ParameterApiService ParameterApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="dashboard-card">
    <div class="page-heading">
        <div>
            <div class="dashboard-kicker">Maintenance</div>
            <h1>Import Approval</h1>
            <p>Review staged Excel import batches before they are applied.</p>
        </div>
    </div>

    <div class="table-toolbar">
        <MudTextField @bind-Value="_search"
                      Placeholder="Search import..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(_ => ReloadAsync())">Search</MudButton>
    </div>

    <MudTable T="ParameterPendingListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              Elevation="0">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="ParameterPendingListItemDto" SortLabel="keyvalue">File</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="ParameterPendingListItemDto" SortLabel="tablename">Target</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="ParameterPendingListItemDto" SortLabel="summary">Summary</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="ParameterPendingListItemDto" SortLabel="requesterfullname">Requester</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="ParameterPendingListItemDto" SortLabel="createddate">Date</MudTableSortLabel></MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="File">@context.KeyValue</MudTd>
            <MudTd DataLabel="Target"><code>@context.TableName</code></MudTd>
            <MudTd DataLabel="Summary">@context.Summary</MudTd>
            <MudTd DataLabel="Requester">@context.RequesterFullName</MudTd>
            <MudTd DataLabel="Date">@context.CreatedDate?.ToString("dd MMM yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Actions">
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="@(_ => ProcessAsync(context.Id, true))">Approve</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(_ => ProcessAsync(context.Id, false))">Reject</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No pending import batches.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<ParameterPendingListItemDto>? _table;
    private string? _search;

    private async Task<TableData<ParameterPendingListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await ParameterApi.GetPendingAsync(new ParameterPendingRequestDto
        {
            TableName = "__import__",
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        });

        return new TableData<ParameterPendingListItemDto> { Items = response.Data, TotalItems = response.TotalCount };
    }

    private async Task ReloadAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task ProcessAsync(Guid id, bool approve)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = approve ? "Approve Import" : "Reject Import",
            ["Message"] = approve ? "Apply all staged rows?" : "Discard this import batch?",
            ["ConfirmText"] = approve ? "Approve" : "Reject",
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(approve ? "Approve Import" : "Reject Import", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = approve
            ? await ParameterApi.ApproveAsync(id)
            : await ParameterApi.RejectAsync(id);

        Snackbar.Add(response.Message ?? "Processed.", response.Success ? Severity.Success : Severity.Error);
        await ReloadAsync();
    }
}
