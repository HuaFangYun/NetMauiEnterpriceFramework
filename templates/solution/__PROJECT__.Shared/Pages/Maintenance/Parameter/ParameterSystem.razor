@page "/dashboard/maintenance/parameter-system"
@page "/dashboard/maintenance/parameter-system/{Mode}"
@page "/dashboard/maintenance/parameter-system/{Mode}/{TableName}"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject ParameterApiService ParameterApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject TabStateService TabService
@inject ExportApiService ExportApi

@if (!IsCardsView)
{
    <MudBreadcrumbs Items="BreadcrumbItems" Separator=">" Class="mb-3" />
}

<MudPaper Elevation="0" Class="dashboard-card">
    <div class="page-heading">
        <div>
            <div class="dashboard-kicker">Parameter</div>
            <h1>@Heading</h1>
            <p>@Subtitle</p>
        </div>
        @if (IsMakerView)
        {
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload" Disabled="@_exporting" OnClick="ExportMakerAsync">
                    @(_exporting ? "Exporting..." : "Export Excel")
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(_ => OpenAddAsync())">Add</MudButton>
            </div>
        }
        else if (IsApprovalView)
        {
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="ApproveAll">Approve All</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DoNotDisturb" OnClick="RejectAll">Reject All</MudButton>
            </div>
        }
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (IsCardsView)
    {
        <MudGrid Spacing="3">
            @foreach (var card in _cards)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudPaper Elevation="0" Class="parameter-card">
                        <div class="parameter-card-title-row">
                            <h3>@card.Description</h3>
                            @if (card.PendingCount > 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.NotificationImportant" Color="Color.Error" Size="Size.Small" />
                            }
                        </div>
                        <div class="parameter-card-footer">
                            <MudIcon Icon="@MenuIconResolver.GetIcon(card.Icon)"
                                     Color="@(IsApprovalCards ? Color.Warning : Color.Primary)"
                                     Size="Size.Large" />
                            <div class="d-flex gap-2">
                                @if (IsMakerCards && card.IsMaker)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="parameter-card-action" OnClick="@(_ => OpenMaker(card))">Maker</MudButton>
                                }
                                @if (IsApprovalCards && card.IsApproval)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Class="parameter-card-action" OnClick="@(_ => OpenApproval(card))">Approval</MudButton>
                                }
                                @if (IsGenericCards)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="parameter-card-action" OnClick="@(_ => OpenMaker(card))">Maker</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Class="parameter-card-action" OnClick="@(_ => OpenApproval(card))">Approval</MudButton>
                                }
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
    else if (IsMakerView)
    {
        <MudTable T="Dictionary<string, string>"
                  @ref="_makerTable"
                  ServerData="LoadMakerData"
                  Hover="true"
                  Dense="false"
                  Breakpoint="Breakpoint.Sm"
                  Elevation="0"
                  HorizontalScrollbar="true">
            <ToolBarContent>
                <MudSpacer />
                <MudTextField @bind-Value="_search"
                              @bind-Value:after="ReloadMakerAsync"
                              Label="Search"
                              Placeholder="Search parameter..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Class="user-search" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh Style="text-align:center;">Actions</MudTh>
                @foreach (var field in _makerFields)
                {
                    <MudTh><MudTableSortLabel T="Dictionary<string, string>" SortLabel="@field.FieldName">@(field.FieldDesc ?? field.FieldName)</MudTableSortLabel></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Actions" Style="text-align:center; white-space:nowrap;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(_ => OpenEditAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(_ => DeleteAsync(context))" />
                </MudTd>
                @foreach (var field in _makerFields)
                {
                    <MudTd DataLabel="@(field.FieldDesc ?? field.FieldName)">@context.GetValueOrDefault(field.FieldName)</MudTd>
                }
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No parameter rows.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    }
    else if (IsApprovalView)
    {
        <MudTable T="ParameterApprovalRowDto"
                  @ref="_approvalTable"
                  ServerData="LoadApprovalData"
                  Hover="true"
                  Dense="false"
                  Breakpoint="Breakpoint.Sm"
                  Elevation="0"
                  HorizontalScrollbar="true">
            <ToolBarContent>
                <MudSpacer />
                <MudTextField @bind-Value="_search"
                              @bind-Value:after="ReloadApprovalAsync"
                              Label="Search"
                              Placeholder="Search..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Class="approval-search" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel T="ParameterApprovalRowDto" SortLabel="idpending">ID Pending</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="ParameterApprovalRowDto" SortLabel="typeparameter">TypeParameter</MudTableSortLabel></MudTh>
                @foreach (var field in _approvalFields)
                {
                    <MudTh><MudTableSortLabel T="ParameterApprovalRowDto" SortLabel="@field.FieldName">@(field.FieldDesc?.Replace("_", " ") ?? field.FieldName)</MudTableSortLabel></MudTh>
                }
                <MudTh Style="text-align:center;">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID Pending" Style="max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    @context.IdPending
                </MudTd>
                <MudTd DataLabel="TypeParameter">@context.TypeParameter</MudTd>
                @foreach (var field in _approvalFields)
                {
                    <MudTd DataLabel="@(field.FieldDesc ?? field.FieldName)">@GetApprovalDisplay(field, context.Fields.GetValueOrDefault(field.FieldName))</MudTd>
                }
                <MudTd DataLabel="Action" Style="text-align:center;">
                    <MudRadioGroup @bind-Value="context.Action" Class="approval-radios">
                        <MudRadio T="int" Value="1" Color="Color.Primary">Approve</MudRadio>
                        <MudRadio T="int" Value="2" Color="Color.Default">Pending</MudRadio>
                        <MudRadio T="int" Value="0" Color="Color.Error">Reject</MudRadio>
                    </MudRadioGroup>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>No pending parameter requests.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudTable>

        <div class="d-flex justify-center mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Gavel" Disabled="@_submittingApproval" OnClick="SubmitApprovalsAsync">
                @(_submittingApproval ? "Submitting..." : "Submit")
            </MudButton>
        </div>
    }
</MudPaper>

@code {
    private const string ParameterComponent = "__PROJECT__.Shared.Pages.Maintenance.Parameter.ParameterSystem, __PROJECT__.Shared";
    private const string ScreenMenuEditorComponent = "__PROJECT__.Shared.Pages.Maintenance.ScreenMenuEditor, __PROJECT__.Shared";
    private const string ImportApprovalComponent = "__PROJECT__.Shared.Pages.Maintenance.Parameter.ImportApproval, __PROJECT__.Shared";

    [Parameter]
    public string? Mode { get; set; }

    [Parameter]
    public string? TableName { get; set; }

    private List<ParameterCardDto> _cards = new();
    private List<ParameterFieldDto> _makerFields = new();
    private List<ParameterFieldDto> _approvalFields = new();
    private List<ParameterApprovalRowDto> _approvalRows = new();
    private Dictionary<string, List<DropdownItemDto>> _approvalOptions = new(StringComparer.OrdinalIgnoreCase);
    private MudTable<Dictionary<string, string>>? _makerTable;
    private MudTable<ParameterApprovalRowDto>? _approvalTable;
    private string? _search;
    private string? _cardDescription;
    private bool _loading;
    private bool _exporting;
    private bool _submittingApproval;

    private bool IsCardsView => string.IsNullOrWhiteSpace(TableName);
    private bool IsMakerView => string.Equals(Mode, "maker", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(TableName);
    private bool IsApprovalView => string.Equals(Mode, "approval", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(TableName);
    private bool IsMakerCards => IsCardsView && string.Equals(Mode, "maker", StringComparison.OrdinalIgnoreCase);
    private bool IsApprovalCards => IsCardsView && string.Equals(Mode, "approval", StringComparison.OrdinalIgnoreCase);
    private bool IsGenericCards => IsCardsView && string.IsNullOrWhiteSpace(Mode);

    private List<BreadcrumbItem> BreadcrumbItems =>
    [
        new("Dashboard", href: "/dashboard"),
        new("Maintenance", href: null),
        new(IsMakerView ? "Parameter Maintenance Maker" : "Parameter Maintenance Approval", href: null),
        new(_cardDescription ?? TableName ?? string.Empty, href: null, disabled: true),
    ];

    private string Heading => IsMakerCards
        ? "Parameter Maintenance Maker"
        : IsApprovalCards
            ? "Parameter Maintenance Approval"
            : IsCardsView
                ? "Parameter System"
                : IsMakerView
                    ? _cardDescription ?? "Parameter Maker"
                    : _cardDescription ?? "Parameter Approval";

    private string Subtitle => IsCardsView
        ? "Choose a parameter table to maintain."
        : IsMakerView
            ? "Create or update parameter requests. Changes require approval."
            : "Review pending parameter requests.";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _search = null;
        _makerFields = new List<ParameterFieldDto>();

        try
        {
            if (IsMakerView)
            {
                _makerFields = await ParameterApi.GetFieldsAsync(TableName!);
                _cards = await ParameterApi.GetCardsAsync();
                _cardDescription = _cards.FirstOrDefault(c => c.Id == TableName)?.Description;
            }
            else if (IsApprovalView)
            {
                _cards = await ParameterApi.GetCardsAsync();
                _cardDescription = _cards.FirstOrDefault(c => c.Id == TableName)?.Description;
                _approvalFields = await ParameterApi.GetFieldsAsync(TableName!);
                _approvalOptions = await ParameterApi.GetOptionsAsync(TableName!);
            }
            else if (IsCardsView)
            {
                _cards = await ParameterApi.GetCardsAsync();
            }
        }
        finally
        {
            _loading = false;
        }

        if (IsMakerView && _makerTable != null)
        {
            await _makerTable.ReloadServerData();
        }

        if (IsApprovalView && _approvalTable != null)
        {
            await _approvalTable.ReloadServerData();
        }
    }

    private async Task<TableData<Dictionary<string, string>>> LoadMakerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await ParameterApi.GetListAsync(TableName!, new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        });

        if (response.Fields.Count > 0)
        {
            _makerFields = response.Fields;
        }

        return new TableData<Dictionary<string, string>> { Items = response.Rows, TotalItems = response.TotalCount };
    }

    private async Task<TableData<ParameterApprovalRowDto>> LoadApprovalData(TableState state, CancellationToken cancellationToken)
    {
        var response = await ParameterApi.GetApprovalRowsAsync(TableName!, new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        });

        _approvalRows = response.Data ?? new List<ParameterApprovalRowDto>();
        foreach (var row in _approvalRows)
        {
            row.Action = 2;
        }

        return new TableData<ParameterApprovalRowDto> { Items = _approvalRows, TotalItems = response.TotalCount };
    }

    private void OpenMaker(ParameterCardDto card)
    {
        if (card.TableName == "tb_screen_menu")
        {
            TabService.OpenTab("Screen Menu Editor", ScreenMenuEditorComponent, "/dashboard/maintenance/screen-menu-editor");
            return;
        }

        TabService.OpenTab(
            $"{card.Description} Maker",
            ParameterComponent,
            $"/dashboard/maintenance/parameter-system/maker/{card.Id}",
            new Dictionary<string, object> { ["Mode"] = "maker", ["TableName"] = card.Id },
            card.Icon);
    }

    private void OpenApproval(ParameterCardDto card)
    {
        TabService.OpenTab(
            $"{card.Description} Approval",
            ParameterComponent,
            $"/dashboard/maintenance/parameter-system/approval/{card.Id}",
            new Dictionary<string, object> { ["Mode"] = "approval", ["TableName"] = card.Id },
            card.Icon);
    }

    private async Task ExportMakerAsync()
    {
        if (string.IsNullOrWhiteSpace(TableName))
        {
            Snackbar.Add("Table is not available.", Severity.Error);
            return;
        }

        _exporting = true;
        try
        {
            var url = await ExportApi.ExportManagementAsync("api/export/parameters", _search, TableName);
            if (string.IsNullOrWhiteSpace(url))
            {
                Snackbar.Add("Export failed. Please try again.", Severity.Error);
                return;
            }

            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task ReloadMakerAsync()
    {
        if (_makerTable != null)
        {
            await _makerTable.ReloadServerData();
        }
    }

    private async Task ReloadApprovalAsync()
    {
        if (_approvalTable != null)
        {
            await _approvalTable.ReloadServerData();
        }
    }

    private void ApproveAll()
    {
        foreach (var row in _approvalRows)
        {
            row.Action = 1;
        }
        StateHasChanged();
    }

    private void RejectAll()
    {
        foreach (var row in _approvalRows)
        {
            row.Action = 0;
        }
        StateHasChanged();
    }

    private async Task OpenAddAsync()
    {
        if (_makerFields.Count == 0)
        {
            Snackbar.Add("Parameter metadata is empty.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["TableName"] = TableName,
            ["Fields"] = _makerFields,
        };

        var dialog = await DialogService.ShowAsync<ParameterEditDialog>("Add Parameter", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadMakerAsync();
        }
    }

    private async Task OpenEditAsync(Dictionary<string, string> row)
    {
        var parameters = new DialogParameters
        {
            ["TableName"] = TableName,
            ["Fields"] = _makerFields,
            ["Row"] = row,
        };

        var dialog = await DialogService.ShowAsync<ParameterEditDialog>("Edit Parameter", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadMakerAsync();
        }
    }

    private async Task DeleteAsync(Dictionary<string, string> row)
    {
        var key = row.GetValueOrDefault("__key");
        var parameters = new DialogParameters
        {
            ["Title"] = "Delete Parameter",
            ["Message"] = $"Delete parameter {TableName}?",
            ["ConfirmText"] = "Delete",
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Parameter", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = await ParameterApi.DeleteAsync(TableName!, key);
        Snackbar.Add(response.Message ?? "Delete failed.", response.Success ? Severity.Success : Severity.Error);
        await ReloadMakerAsync();
    }

    private string GetApprovalDisplay(ParameterFieldDto field, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        if (string.Equals(field.FieldType, "bit", StringComparison.OrdinalIgnoreCase))
        {
            return value == "1" || value.Equals("true", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No";
        }

        if (string.Equals(field.FieldType, "list", StringComparison.OrdinalIgnoreCase)
            && _approvalOptions.TryGetValue(field.FieldName, out var options))
        {
            return options.FirstOrDefault(option => option.Value == value)?.Text ?? value;
        }

        return value;
    }

    private async Task SubmitApprovalsAsync()
    {
        var approveIds = _approvalRows.Where(x => x.Action == 1).Select(x => x.IdPending).ToList();
        var rejectIds = _approvalRows.Where(x => x.Action == 0).Select(x => x.IdPending).ToList();

        if (approveIds.Count == 0 && rejectIds.Count == 0)
        {
            Snackbar.Add("No approvals or rejections selected.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Title"] = "Confirm Submission",
            ["Message"] = $"Approve {approveIds.Count} item(s) and reject {rejectIds.Count} item(s)?",
            ["ConfirmText"] = "Submit",
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Submission", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        _submittingApproval = true;
        try
        {
            var failed = 0;
            foreach (var id in approveIds)
            {
                var response = await ParameterApi.ApproveAsync(id);
                if (!response.Success)
                {
                    failed++;
                }
            }

            foreach (var id in rejectIds)
            {
                var response = await ParameterApi.RejectAsync(id);
                if (!response.Success)
                {
                    failed++;
                }
            }

            Snackbar.Add(
                failed == 0 ? "Approval processed successfully." : $"{failed} request(s) failed.",
                failed == 0 ? Severity.Success : Severity.Error);
            await ReloadApprovalAsync();
        }
        finally
        {
            _submittingApproval = false;
        }
    }
}
