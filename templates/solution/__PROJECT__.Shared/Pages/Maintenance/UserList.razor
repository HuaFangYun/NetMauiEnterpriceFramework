@page "/dashboard/maintenance/user-list"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject SettingApiService SettingApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ApiService ApiService
@inject ITokenStorage TokenStorage
@inject NavigationManager Navigation

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">Maintenance</div>
        <h1>User Management</h1>
        <p>Manage application users and their roles.</p>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(_ => OpenAddAsync())">Add User</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload" Disabled="@_isExporting" OnClick="@(_ => ExportExcelAsync())">
            @(_isExporting ? "Exporting..." : "Export Excel")
        </MudButton>
    </div>
</div>

<MudPaper Elevation="0" Class="dashboard-card">
    <MudTable T="UserListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="Search"
                          Placeholder="Search by ID, name, email..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="user-search" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="text-align:center;">Actions</MudTh>
            <MudTh>User Id</MudTh>
            <MudTh>Nomor Induk Karyawan</MudTh>
            <MudTh>Branch</MudTh>
            <MudTh>Full Name</MudTh>
            <MudTh>Gender</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Phone Number</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Actions" Style="text-align:center; white-space:nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(_ => OpenEditAsync(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(_ => DeleteAsync(context))" />
            </MudTd>
            <MudTd DataLabel="User Id">@context.UserId</MudTd>
            <MudTd DataLabel="Nomor Induk Karyawan">@context.NomorIndukKaryawan</MudTd>
            <MudTd DataLabel="Branch">@context.KodeCabang</MudTd>
            <MudTd DataLabel="Full Name">@context.FullName</MudTd>
            <MudTd DataLabel="Gender">@context.GenderName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Phone Number">@context.PhoneNumber</MudTd>
            <MudTd DataLabel="Role">@context.GroupName</MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsLocked)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Locked</MudChip>
                }
                else if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Inactive</MudChip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No users found.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Dashboard", href: "/dashboard"),
        new("Maintenance", href: null),
        new("User Management", href: null, disabled: true),
    ];

    private MudTable<UserListItemDto>? _table;
    private string? _search;
    private bool _isExporting;

    private async Task<TableData<UserListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var sortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc";
        var response = await SettingApi.GetUsersAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = sortDirection,
        });

        return new TableData<UserListItemDto>
        {
            Items = response.Data,
            TotalItems = response.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task ReloadAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenAddAsync()
    {
        var dialog = await DialogService.ShowAsync<AddEditUserDialog>("Add User");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditAsync(UserListItemDto user)
    {
        var parameters = new DialogParameters { ["User"] = user };
        var dialog = await DialogService.ShowAsync<AddEditUserDialog>("Edit User", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync(UserListItemDto user)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Delete User",
            ["Message"] = $"Delete user {user.UserId}?",
            ["ConfirmText"] = "Delete",
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete User", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        var response = await SettingApi.DeleteUserAsync(user.UserId);
        Snackbar.Add(response.Message ?? "Delete failed.", response.Success ? Severity.Success : Severity.Error);
        await ReloadAsync();
    }

    private async Task ExportExcelAsync()
    {
        var baseAddress = ApiService.ApiBaseAddress;
        if (string.IsNullOrWhiteSpace(baseAddress))
        {
            Snackbar.Add("API address is not available.", Severity.Error);
            return;
        }

        _isExporting = true;
        try
        {
            var token = await TokenStorage.GetAccessTokenAsync();
            var query = $"?access_token={Uri.EscapeDataString(token ?? string.Empty)}";
            if (!string.IsNullOrWhiteSpace(_search))
            {
                query += $"&search={Uri.EscapeDataString(_search)}";
            }

            Navigation.NavigateTo($"{baseAddress}/api/user/export{query}", forceLoad: true);
        }
        finally
        {
            _isExporting = false;
        }
    }
}
