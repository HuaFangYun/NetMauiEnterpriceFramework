@page "/change-password"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
    <MudPaper Elevation="0" Class="dashboard-card">
        <div class="dashboard-kicker">Account</div>
        <h1>Change Password</h1>
        <p>Use a strong password and keep it private.</p>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <EditForm Model="@_model" OnValidSubmit="@OnSubmitAsync">
            <DataAnnotationsValidator />
            <div class="login-form-fields">
                <MudTextField @bind-Value="_model.CurrentPassword" Label="Current Password" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" />
                <MudTextField @bind-Value="_model.NewPassword" Label="New Password" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" />
                <MudTextField @bind-Value="_model.ConfirmNewPassword" Label="Confirm New Password" Variant="Variant.Outlined" InputType="InputType.Password" FullWidth="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@_isLoading">Change Password</MudButton>
            </div>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private readonly ChangePasswordDto _model = new();
    private bool _isLoading;
    private string? _error;

    private async Task OnSubmitAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            await AuthService.ChangePasswordAsync(_model);
            Snackbar.Add("Password changed successfully.", Severity.Success);
            Navigation.NavigateTo("/dashboard", true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
