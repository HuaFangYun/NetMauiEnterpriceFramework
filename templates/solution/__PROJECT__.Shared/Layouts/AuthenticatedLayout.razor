@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject MenuService MenuService
@inject TabStateService TabService
@inject DynamicComponentResolver ComponentResolver
@inject ITokenStorage TokenStorage
@inject AuthService AuthService
@inject INotifyAuthenticationState AuthStateNotifier
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject NotificationApiService NotificationApi
@inject ApiService ApiService
@inject IHttpMessageHandlerFactory HttpMessageHandlerFactory
@inject ILogger<AuthenticatedLayout> Logger
@inject IJSRuntime JS
@inject IBrowserViewportService ViewportService

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />

<MudLayout Class="@ShellClass" @onclick="CloseSearch">
    <MudAppBar Elevation="1" Class="app-topbar">
        <div class="app-brand" title="@BrandName">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" Class="app-brand-icon" />
            <MudText Typo="Typo.h6" Class="app-brand-text">@BrandName</MudText>
        </div>
        <MudIconButton Icon="@(DrawerToggleState ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                       Color="Color.Inherit"
                       Class="app-drawer-toggle ml-2"
                       aria-label="@(DrawerToggleState ? "Collapse navigation" : "Expand navigation")"
                       OnClick="@(_ => ToggleDrawer())" />
        <MudSpacer />
        <div class="search-wrapper" @onclick:stopPropagation="true">
            <div class="search-box">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Color="Color.Secondary" />
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              @bind-Value:after="OnSearchChanged"
                              Placeholder="Search data..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Style="border:none; background:transparent; padding:0; flex:1;"
                              Class="search-input"
                              @onfocus="OpenSearch" />
            </div>

            <MudPopover Open="@(_searchOpen && !string.IsNullOrWhiteSpace(_searchTerm))"
                        AnchorOrigin="Origin.BottomLeft"
                        TransformOrigin="Origin.TopLeft"
                        RelativeWidth="DropdownWidth.Relative"
                        Class="search-popover">
                <MudPaper Elevation="4" Class="search-results">
                    @if (_filteredResults.Count > 0)
                    {
                        @foreach (var result in _filteredResults)
                        {
                            <button type="button" class="search-result" @onclick="() => OpenSearchResult(result)">
                                <div class="search-result-title">@result.Item.MenuName</div>
                                <div class="search-result-subtitle">@result.Path</div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="search-empty">No results found.</div>
                    }
                </MudPaper>
            </MudPopover>
        </div>
        <div class="notification-wrapper">
            <MudBadge Color="Color.Secondary"
                      Visible="@(_unreadCount > 0)"
                      Content="@_unreadCount.ToString()"
                      Overlap="true">
                <MudIconButton Icon="@(_unreadCount > 0 ? Icons.Material.Outlined.NotificationsActive : Icons.Material.Outlined.Notifications)"
                               Color="Color.Inherit"
                               OnClick="@(_ => ToggleNotificationPopover())" />
            </MudBadge>

            <MudPopover Open="_notificationPopoverOpen"
                        AnchorOrigin="Origin.BottomRight"
                        TransformOrigin="Origin.TopRight"
                        Class="notification-popover">
                <MudPaper Elevation="4" Class="notification-panel">
                    <div class="notification-panel-head">
                        <div class="d-flex align-items-center gap-2">
                            <MudText Typo="Typo.h6">Notifications</MudText>
                            @if (_unreadCount > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">@_unreadCount</MudChip>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @if (_unreadCount > 0)
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="@(_ => MarkAllSeenAsync())">Mark all read</MudButton>
                            }
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="@(_ => OpenNotificationList())">View All</MudButton>
                        </div>
                    </div>

                    <div class="notification-list">
                        @if (_notifications.Count == 0)
                        {
                            <div class="notification-empty">
                                <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Color="Color.Error" Size="Size.Large" />
                                <MudText Color="Color.Error">No notifications</MudText>
                            </div>
                        }
                        else
                        {
                            @foreach (var notification in _notifications.Take(8))
                            {
                                <div class="notification-item" @onclick="@(() => OpenNotificationAsync(notification))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" Size="Size.Small" Class="mt-1" />
                                    <div class="notification-item-copy">
                                        <div class="notification-title">@(notification.ShortText ?? notification.Type ?? "Notification")</div>
                                        <div class="notification-body">@notification.LongText</div>
                                        <div class="notification-time">@notification.CreatedDate?.ToString("dd MMM yyyy HH:mm")</div>
                                    </div>
                                    @if (!notification.IsSeen)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailUnread" Color="Color.Primary" Size="Size.Small" />
                                    }
                                </div>
                            }
                        }
                    </div>
                </MudPaper>
            </MudPopover>
            @if (_notificationPopoverOpen)
            {
                <div class="notification-backdrop" @onclick="CloseNotificationPopover"></div>
            }
        </div>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                       OnClick="@(_ => ToggleDarkMode())" />
        <MudIconButton Icon="@Icons.Material.Filled.Brush"
                       Color="Color.Inherit"
                       aria-label="@(_neoBrutalism ? "Use classic style" : "Try neo brutalism")"
                       title="@(_neoBrutalism ? "Classic style" : "Neo brutalism")"
                       OnClick="@(_ => ToggleNeoBrutalismAsync())" />
        <MudMenu>
            <ActivatorContent Context="accountMenu">
                <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                               Color="Color.Inherit"
                               OnClick="@(_ => accountMenu.ToggleAsync())" />
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(_ => OpenProfile())">Profile</MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="@(_ => LogoutAsync())">Logout</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer Open="@DrawerIsOpen"
               Width="@DrawerWidth"
               Elevation="1"
               Variant="@CurrentDrawerVariant"
               ClipMode="@CurrentDrawerClipMode"
               Overlay="@_isMobile"
               OverlayAutoClose="true"
               OpenChanged="OnDrawerOpenChanged">
        <MudNavMenu Class="@(ShowExpandedNavigation ? "pa-3 sidebar-expanded" : "pa-2 sidebar-collapsed")">
            @if (ShowExpandedNavigation)
            {
                <div class="sidebar-brand">
                    <div class="sidebar-brand-icon">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
                    </div>
                    <div class="sidebar-brand-copy">
                        <div class="sidebar-brand-title">@BrandName</div>
                        <div class="sidebar-brand-subtitle">Enterprise Portal</div>
                    </div>
                </div>

                <MudDivider Class="my-3" />

                @foreach (var item in _menuItems)
                {
                    <RecursiveMenuItem Item="item"
                                       OnOpen="OpenMenu"
                                       Expanded="@(_expandedParentUnique == item.MenuUnique)" />
                }
            }
            else
            {
                <div class="sidebar-rail-brand">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
                </div>
                <MudDivider Class="my-2" />
                <div class="sidebar-rail">
                    @for (var index = 0; index < _menuItems.Count; index++)
                    {
                        var item = _menuItems[index];
                        <button type="button"
                                class="sidebar-rail-item"
                                style="animation-delay:@(index * 25)ms"
                                title="@item.MenuName"
                                aria-label="@item.MenuName"
                                @onclick="@(() => ExpandFromRail(item))">
                            <MudIcon Icon="@MenuIconResolver.GetIcon(item.MenuIcon)" />
                        </button>
                    }
                </div>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="app-main-container">
            @if (TabService.Tabs.Count > 0)
            {
                <MudTabs @bind-ActivePanelIndex="_selectedTabIndex" Elevation="0" Rounded="true" KeepPanelsAlive="true" Class="enterprise-tabs">
                    @foreach (var tab in TabService.Tabs)
                    {
                        <MudTabPanel @key="tab.Id">
                            <TabContent>
                                <div class="tab-header">
                                    <MudIcon Icon="@MenuIconResolver.GetIcon(tab.Icon)" Color="Color.Primary" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@tab.Title</MudText>
                                    <span class="tab-header-actions" @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                                       Size="Size.Small"
                                                       OnClick="@(_ => RefreshTab(tab))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       OnClick="@(_ => CloseTab(tab))" />
                                    </span>
                                </div>
                            </TabContent>
                            <ChildContent>
                                @{
                                    var componentType = GetComponentType(tab);
                                }

                                @if (componentType != null)
                                {
                                    <DynamicComponent Type="componentType" Parameters="tab.Parameters" @key="tab.RefreshKey" />
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Class="mt-4">This module is not implemented yet.</MudAlert>
                                }
                            </ChildContent>
                        </MudTabPanel>
                    }
                </MudTabs>
            }
            else
            {
                <MudAlert Severity="Severity.Info">Select a menu to start.</MudAlert>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private const string BrandName = "__PROJECT__";
    private const string DashboardComponent = "__PROJECT__.Shared.Pages.Dashboard, __PROJECT__.Shared";
    private const string ProfileComponent = "__PROJECT__.Shared.Pages.Profile, __PROJECT__.Shared";
    private const string NotificationsComponent = "__PROJECT__.Shared.Pages.Notifications, __PROJECT__.Shared";

    private const string StyleStorageKey = "enterprise-ui-style";
    private readonly Guid _viewportObserverId = Guid.NewGuid();
    private bool _drawerExpanded = true;
    private bool _sidebarCompact;
    private bool _neoBrutalism = true;
    private bool _isMobile;
    private bool _mobileMenuOpen;
    private string? _expandedParentUnique;
    private string ShellClass => $"{(_isDarkMode ? "app-dark" : "app-light")} {(_drawerExpanded ? "app-shell-expanded" : "app-shell-collapsed")} {(_neoBrutalism ? "neo-brutalism" : string.Empty)}";
    private bool DrawerToggleState => _isMobile ? _mobileMenuOpen : _drawerExpanded;
    private bool DrawerIsOpen => _isMobile ? _mobileMenuOpen : true;
    private string DrawerWidth => _isMobile || _drawerExpanded ? "240px" : "72px";
    private bool ShowExpandedNavigation => _isMobile || _drawerExpanded;
    private DrawerVariant CurrentDrawerVariant => _isMobile ? DrawerVariant.Temporary : DrawerVariant.Persistent;
    private DrawerClipMode CurrentDrawerClipMode => _isMobile ? DrawerClipMode.Never : DrawerClipMode.Always;
    private bool _notificationPopoverOpen;
    private bool _isDarkMode;
    private int _unreadCount = 0;
    private int _selectedTabIndex;
    private string? _userName;
    private string _searchTerm = string.Empty;
    private bool _searchOpen;
    private List<MenuSearchResult> _filteredResults = new();
    private List<MenuItemDto> _menuItems = new();
    private List<NotificationDto> _notifications = new();
    private HubConnection? _hub;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#004481",
            Secondary = "#b6171e",
            Background = "#f9f9ff",
            Surface = "#ffffff",
            AppbarBackground = "#ffffff",
            AppbarText = "#004481",
            DrawerBackground = "#ffffff",
            DrawerText = "#263143",
            TextPrimary = "#111c2d",
            TextSecondary = "#5b6472",
            ActionDefault = "#5b6472",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#a5c8ff",
            Secondary = "#ffb3ac",
            Background = "#111c2d",
            Surface = "#1b2638",
            AppbarBackground = "#162235",
            AppbarText = "#e8eef9",
            DrawerBackground = "#162235",
            DrawerText = "#dbe6f5",
            TextPrimary = "#e8eef9",
            TextSecondary = "#b8c4d9",
            ActionDefault = "#b8c4d9",
            Divider = "rgba(255, 255, 255, .12)",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Plus Jakarta Sans", "sans-serif" },
            },
        },
    };

    protected override async Task OnInitializedAsync()
    {
        TabService.OnTabsChanged += OnTabsChanged;
        _menuItems = await MenuService.GetUserMenuAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userName = authState.User.Identity?.Name;

        try
        {
            _notifications = await NotificationApi.GetRecentAsync();
            _unreadCount = _notifications.Count(e => !e.IsSeen);
        }
        catch
        {
            // Notifications are non-blocking; the rest of the shell remains usable.
        }

        _ = StartHubAsync();

        if (TabService.Tabs.Count == 0)
        {
            TabService.OpenTab("Dashboard", DashboardComponent, "/dashboard", icon: "Home");
        }

        SyncSelectedTab();
    }

    private async Task StartHubAsync()
    {
        if (string.IsNullOrWhiteSpace(ApiService.ApiBaseAddress))
        {
            return;
        }

        _hub = new HubConnectionBuilder()
            .WithUrl($"{ApiService.ApiBaseAddress}/userHub", options =>
            {
                options.AccessTokenProvider = async () => await TokenStorage.GetAccessTokenAsync();
                options.HttpMessageHandlerFactory = _ => HttpMessageHandlerFactory.CreateHandler("SignalR");
            })
            .WithAutomaticReconnect()
            .Build();

        _hub.On<NotificationDto>("ReceiveNotification", notification =>
        {
            _ = InvokeAsync(() =>
            {
                _notifications.Insert(0, notification);
                if (!notification.IsSeen)
                {
                    _unreadCount++;
                }

                StateHasChanged();
            });
        });

        _hub.On<string>("SessionRevoked", message =>
        {
            _ = InvokeAsync(async () =>
            {
                await TokenStorage.RemoveTokensAsync();
                AuthStateNotifier.NotifyUserLogout();
                Navigation.NavigateTo("/", true);
            });
        });

        try
        {
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SignalR connection failed. REST notifications remain available.");
        }
    }

    private void ToggleNotificationPopover() => _notificationPopoverOpen = !_notificationPopoverOpen;

    private void CloseNotificationPopover() => _notificationPopoverOpen = false;

    private void OpenNotificationList()
    {
        _notificationPopoverOpen = false;
        TabService.OpenTab("Notifications", NotificationsComponent, "/notifications", icon: "Notifications");
    }

    private async Task OpenNotificationAsync(NotificationDto notification)
    {
        _notificationPopoverOpen = false;

        if (!notification.IsSeen)
        {
            await NotificationApi.MarkSeenAsync(notification.Id);
            notification.IsSeen = true;
            _unreadCount = Math.Max(0, _unreadCount - 1);
        }

        if (string.IsNullOrWhiteSpace(notification.Href))
        {
            return;
        }

        if (notification.Href.StartsWith("/api/export/download", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(ApiService.ApiBaseAddress))
        {
            var token = await TokenStorage.GetAccessTokenAsync();
            Navigation.NavigateTo(
                $"{ApiService.ApiBaseAddress}{notification.Href}?access_token={Uri.EscapeDataString(token ?? string.Empty)}",
                forceLoad: true);
            return;
        }

        Navigation.NavigateTo(notification.Href);
    }

    private async Task MarkAllSeenAsync()
    {
        await NotificationApi.MarkAllSeenAsync();
        foreach (var notification in _notifications)
        {
            notification.IsSeen = true;
        }

        _unreadCount = 0;
        StateHasChanged();
    }

    private void OnTabsChanged()
    {
        _ = InvokeAsync(() =>
        {
            SyncSelectedTab();
            StateHasChanged();
        });
    }

    private void SyncSelectedTab()
    {
        if (TabService.ActiveTab == null)
        {
            _selectedTabIndex = 0;
            return;
        }

        var index = TabService.Tabs.IndexOf(TabService.ActiveTab);
        _selectedTabIndex = index < 0 ? 0 : index;
    }

    private Type? GetComponentType(AppTabDto tab)
        => ComponentResolver.ResolveComponentType(tab.ComponentType);

    private void ToggleDrawer()
    {
        if (_isMobile)
        {
            _mobileMenuOpen = !_mobileMenuOpen;
            if (_mobileMenuOpen)
            {
                _drawerExpanded = true;
                _expandedParentUnique = null;
            }

            return;
        }

        if (_sidebarCompact)
        {
            _sidebarCompact = false;
            _drawerExpanded = true;
            return;
        }

        _sidebarCompact = true;
        _drawerExpanded = false;
        _expandedParentUnique = null;
    }

    private void OnDrawerOpenChanged(bool open)
    {
        if (!_isMobile)
        {
            return;
        }

        _mobileMenuOpen = open;
        if (!open)
        {
            _expandedParentUnique = null;
        }
    }

    private void OnViewportChanged(BrowserViewportEventArgs args)
    {
        var mobile = args.Breakpoint is Breakpoint.Xs or Breakpoint.Sm or Breakpoint.Md;

        _ = InvokeAsync(() =>
        {
            if (_isMobile == mobile)
            {
                return;
            }

            _isMobile = mobile;
            if (mobile)
            {
                _mobileMenuOpen = false;
                _drawerExpanded = true;
            }

            StateHasChanged();
        });
    }

    private void ExpandFromRail(MenuItemDto item)
    {
        _drawerExpanded = true;
        _expandedParentUnique = item.MenuUnique;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var savedStyle = await JS.InvokeAsync<string?>("localStorage.getItem", StyleStorageKey);
            if (string.Equals(savedStyle, "classic", StringComparison.OrdinalIgnoreCase))
            {
                _neoBrutalism = false;
                StateHasChanged();
            }
        }
        catch
        {
            // Storage can be unavailable during prerender; keep the default style.
        }

        try
        {
            await ViewportService.SubscribeAsync(_viewportObserverId, OnViewportChanged, null, true);
        }
        catch
        {
            // Keep desktop behavior when the viewport listener is unavailable.
        }
    }

    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    private async Task ToggleNeoBrutalismAsync()
    {
        _neoBrutalism = !_neoBrutalism;

        try
        {
            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                StyleStorageKey,
                _neoBrutalism ? "neo" : "classic");
        }
        catch
        {
            // The visual toggle still works when storage is unavailable.
        }
    }

    private void OpenMenu(MenuItemDto item)
    {
        if (string.IsNullOrWhiteSpace(item.ComponentType))
        {
            Snackbar.Add("This menu is not implemented yet.", Severity.Info);
            return;
        }

        var parameters = new Dictionary<string, object>();
        if (item.ComponentType.Equals("DynamicScreen", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.MenuUrl))
        {
            parameters["ScreenId"] = item.MenuUrl;
        }
        else if (item.ComponentType.Equals("DynamicReport", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.MenuUrl))
        {
            parameters["ReportId"] = item.MenuUrl;
        }
        else if (item.ComponentType.Contains("ParameterSystem", StringComparison.OrdinalIgnoreCase)
                 && !string.IsNullOrWhiteSpace(item.MenuUrl))
        {
            var segments = item.MenuUrl.Trim('/').Split('/');
            var modeIndex = Array.FindIndex(segments, segment =>
                segment.Equals("maker", StringComparison.OrdinalIgnoreCase)
                || segment.Equals("approval", StringComparison.OrdinalIgnoreCase));

            if (modeIndex >= 0)
            {
                parameters["Mode"] = segments[modeIndex];
                if (modeIndex + 1 < segments.Length)
                {
                    parameters["TableName"] = segments[modeIndex + 1];
                }
            }
        }

        TabService.OpenTab(
            item.MenuName,
            item.ComponentType,
            item.MenuUrl,
            parameters.Count > 0 ? parameters : null,
            item.MenuIcon);

        if (_isMobile)
        {
            _mobileMenuOpen = false;
            _expandedParentUnique = null;
        }
        else if (_sidebarCompact)
        {
            _drawerExpanded = false;
            _expandedParentUnique = null;
        }
    }

    private void OpenProfile()
        => TabService.OpenTab("Profile", ProfileComponent, "/profile", icon: "Person");

    private void RefreshTab(AppTabDto tab) => TabService.RefreshTab(tab);

    private void CloseTab(AppTabDto tab)
    {
        var active = TabService.ActiveTab;
        TabService.CloseTab(tab);

        if (TempDataNeedsDashboard(active, tab))
        {
            TabService.OpenTab("Dashboard", DashboardComponent, "/dashboard", icon: "Home");
        }
    }

    private bool TempDataNeedsDashboard(AppTabDto? active, AppTabDto closed)
        => active == closed && TabService.Tabs.Count == 0;

    private async Task LogoutAsync()
    {
        var refreshToken = await TokenStorage.GetRefreshTokenAsync();
        await AuthService.LogoutAsync(refreshToken);
        AuthStateNotifier.NotifyUserLogout();
        Navigation.NavigateTo("/", true);
    }

    private void OpenSearch()
    {
        _searchOpen = true;
        OnSearchChanged();
    }

    private void CloseSearch() => _searchOpen = false;

    private void OnSearchChanged()
    {
        _searchOpen = true;
        _filteredResults = string.IsNullOrWhiteSpace(_searchTerm)
            ? new List<MenuSearchResult>()
            : FlattenWithPath(_menuItems)
                .Where(m => !string.IsNullOrWhiteSpace(m.Item.ComponentType)
                            && (m.Item.MenuName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                                || m.Path.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)))
                .Take(10)
                .ToList();
    }

    private void OpenSearchResult(MenuSearchResult result)
    {
        OpenMenu(result.Item);
        _searchTerm = string.Empty;
        _filteredResults.Clear();
        _searchOpen = false;
    }

    private static IEnumerable<MenuSearchResult> FlattenWithPath(IEnumerable<MenuItemDto> items, string parentPath = "")
    {
        foreach (var item in items)
        {
            var path = string.IsNullOrWhiteSpace(parentPath)
                ? item.MenuName
                : $"{parentPath} -> {item.MenuName}";

            yield return new MenuSearchResult(item, path);

            foreach (var child in FlattenWithPath(item.Children, path))
            {
                yield return child;
            }
        }
    }

    private sealed record MenuSearchResult(MenuItemDto Item, string Path);

    public void Dispose()
    {
        _ = ViewportService.UnsubscribeAsync(_viewportObserverId);
        TabService.OnTabsChanged -= OnTabsChanged;
        if (_hub != null)
        {
            _ = _hub.DisposeAsync();
        }
    }
}
