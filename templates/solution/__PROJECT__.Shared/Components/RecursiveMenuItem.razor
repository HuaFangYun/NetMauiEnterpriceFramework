@using __PROJECT__.Application.DTOs.Menu
@using __PROJECT__.Shared.Utils

@if (Item.Children is { Count: > 0 })
{
    <MudNavGroup Title="@Item.MenuName"
                 Icon="@MenuIconResolver.GetIcon(Item.MenuIcon)"
                 Expanded="true">
        @if (Item.Children.All(child => child.Children is not { Count: > 0 }))
        {
            <div class="menu-tile-grid">
                @foreach (var child in Item.Children.OrderBy(c => c.OrderSeq))
                {
                    <RecursiveMenuItem Item="child" OnOpen="OnOpen" AsTile="true" />
                }
            </div>
        }
        else
        {
            @foreach (var child in Item.Children.OrderBy(c => c.OrderSeq))
            {
                <RecursiveMenuItem Item="child" OnOpen="OnOpen" />
            }
        }
    </MudNavGroup>
}
else if (AsTile)
{
    <button type="button"
            class="menu-tile"
            disabled="@(string.IsNullOrWhiteSpace(Item.ComponentType))"
            @onclick="@(() => OnOpen.InvokeAsync(Item))">
        <MudIcon Icon="@MenuIconResolver.GetIcon(Item.MenuIcon)" />
        <span>@Item.MenuName</span>
    </button>
}
else
{
    <MudNavLink Icon="@MenuIconResolver.GetIcon(Item.MenuIcon)"
                Disabled="@(string.IsNullOrWhiteSpace(Item.ComponentType))"
                OnClick="@(_ => OnOpen.InvokeAsync(Item))">
        @Item.MenuName
    </MudNavLink>
}

@code {
    [Parameter, EditorRequired]
    public MenuItemDto Item { get; set; } = new();

    [Parameter]
    public EventCallback<MenuItemDto> OnOpen { get; set; }

    [Parameter]
    public bool AsTile { get; set; }
}
