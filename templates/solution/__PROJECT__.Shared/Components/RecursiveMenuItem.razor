@using __PROJECT__.Application.DTOs.Menu
@using __PROJECT__.Shared.Utils

@if (Item.Children is { Count: > 0 })
{
    <div class="sidebar-group @(_expanded ? "sidebar-group-open" : string.Empty)">
        <button type="button"
                class="sidebar-link sidebar-group-toggle"
                aria-expanded="@_expanded"
                @onclick="Toggle">
            <MudIcon Icon="@MenuIconResolver.GetIcon(Item.MenuIcon)" Class="sidebar-link-icon" />
            <span class="sidebar-label" title="@Item.MenuName">
                <span class="sidebar-label-text @LongLabelClass">@Item.MenuName</span>
            </span>
            <MudIcon Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Class="sidebar-arrow" />
        </button>

        @if (_expanded)
        {
            <div class="sidebar-children">
                @if (Item.Children.All(child => child.Children is not { Count: > 0 }))
                {
                    <div class="menu-tile-grid">
                        @foreach (var child in Item.Children.OrderBy(c => c.OrderSeq))
                        {
                            <RecursiveMenuItem Item="child" OnOpen="OnOpen" AsTile="true" />
                        }
                    </div>
                }
                else
                {
                    @foreach (var child in Item.Children.OrderBy(c => c.OrderSeq))
                    {
                        <RecursiveMenuItem Item="child" OnOpen="OnOpen" />
                    }
                }
            </div>
        }
    </div>
}
else if (AsTile)
{
    <button type="button"
            class="menu-tile"
            disabled="@(string.IsNullOrWhiteSpace(Item.ComponentType))"
            @onclick="@(() => OnOpen.InvokeAsync(Item))">
        <MudIcon Icon="@MenuIconResolver.GetIcon(Item.MenuIcon)" />
        <span>@Item.MenuName</span>
    </button>
}
else
{
    <button type="button"
            class="sidebar-link"
            disabled="@(string.IsNullOrWhiteSpace(Item.ComponentType))"
            @onclick="@(() => OnOpen.InvokeAsync(Item))">
        <MudIcon Icon="@MenuIconResolver.GetIcon(Item.MenuIcon)" Class="sidebar-link-icon" />
        <span class="sidebar-label" title="@Item.MenuName">
            <span class="sidebar-label-text @LongLabelClass">@Item.MenuName</span>
        </span>
    </button>
}

@code {
    [Parameter, EditorRequired]
    public MenuItemDto Item { get; set; } = new();

    [Parameter]
    public EventCallback<MenuItemDto> OnOpen { get; set; }

    [Parameter]
    public bool AsTile { get; set; }

    private bool _expanded;

    private string? LongLabelClass => Item.MenuName.Length > 14 ? "sidebar-label-long" : null;

    private void Toggle() => _expanded = !_expanded;
}
