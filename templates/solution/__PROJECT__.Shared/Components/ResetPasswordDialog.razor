@inject SettingApiService SettingApi
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Reset Password</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-4">Set a new password for <strong>@UserId</strong>.</MudText>
        <MudTextField @bind-Value="_password"
                      Label="New Password"
                      Variant="Variant.Text"
                      InputType="InputType.Password"
                      Required="true" />
        <MudTextField @bind-Value="_confirmation"
                      Label="Confirm New Password"
                      Variant="Variant.Text"
                      InputType="InputType.Password"
                      Required="true"
                      Class="mt-4" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(_ => MudDialog.Cancel())">Close</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="SubmitAsync">
            @(_saving ? "Saving..." : "Reset Password")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    private string _password = string.Empty;
    private string _confirmation = string.Empty;
    private bool _saving;

    private async Task SubmitAsync()
    {
        if (_password.Length < 8)
        {
            Snackbar.Add("Password must be at least 8 characters.", Severity.Warning);
            return;
        }

        if (!string.Equals(_password, _confirmation, StringComparison.Ordinal))
        {
            Snackbar.Add("Passwords do not match.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var result = await SettingApi.ResetUserPasswordAsync(UserId, _password);
            if (result.Success)
            {
                Snackbar.Add(result.Message ?? "Password reset successfully.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Reset failed.", Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
