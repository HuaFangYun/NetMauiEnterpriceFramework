@inject ScreenMenuApiService ScreenMenuApi
@inject ISnackbar Snackbar

<MudDialog Class="screen-editor-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Edit Screen Menu" : "Add Screen Menu")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">
            <MudTabPanel Text="Screen">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_model.Id" Label="Screen ID" Variant="Variant.Outlined" Required="true" Disabled="@IsEdit" />
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_model.Description" Label="Description" Variant="Variant.Outlined" Required="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <div class="d-flex flex-wrap gap-3">
                            <MudCheckBox T="bool" @bind-Value="_model.HasButtonLoad" Label="Load" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="_model.HasButtonProcess" Label="Process" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="_model.HasButtonGenerateTxt" Label="Generate TXT" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="_model.HasButtonExportExcel" Label="Export Excel" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="_model.HasButtonAdd" Label="Add" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="_model.HasButtonDelete" Label="Delete" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="_model.HasActionRow" Label="Action Row" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="_model.HasButtonImportExcel" Label="Import Excel" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="_model.IsActive" Label="Active" Color="Color.Primary" />
                        </div>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.FieldFilter" Label="field_filter" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.QueryLoad" Label="query_load" Variant="Variant.Outlined" Lines="3" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.QueryLoadParam" Label="query_load_param" Variant="Variant.Outlined" Lines="3" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.QueryProcess" Label="query_process" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.QueryProcessParam" Label="query_process_param" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.QueryExportTxt" Label="query_export_txt" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.QueryExportTxtParam" Label="query_export_txt_param" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.QueryDelete" Label="query_delete" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.QueryDeleteParam" Label="query_delete_param" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Child">
                <div class="d-flex align-center gap-3 mb-3">
                    <MudSwitch T="bool" @bind-Value="_hasChild" Color="Color.Primary" Label="Enable child" />
                </div>
                @if (_hasChild)
                {
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_child.ScreenMenuChildId" Label="Child ID" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="5">
                            <MudTextField @bind-Value="_child.Description" Label="Description" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string" @bind-Value="_child.Type" Label="Type" Variant="Variant.Outlined" Clearable="true">
                                <MudSelectItem Value="@("modal")">modal</MudSelectItem>
                                <MudSelectItem Value="@("url")">url</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_child.UrlAction" Label="url_action" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_child.UrlActionParam" Label="url_action_param" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_child.ModalField" Label="modal_field" Variant="Variant.Outlined" Lines="2" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_child.ModalDetailFieldQuery" Label="modal_detail_field_query" Variant="Variant.Outlined" Lines="3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_child.ModalDetailFieldQueryParam" Label="modal_detail_field_query_param" Variant="Variant.Outlined" Lines="3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_child.ModalSaveProcessQuery" Label="modal_save_process_query" Variant="Variant.Outlined" Lines="3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_child.ModalSaveProcessQueryParam" Label="modal_save_process_query_param" Variant="Variant.Outlined" Lines="3" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudCheckBox T="bool" @bind-Value="_child.IsActive" Label="Active" Color="Color.Primary" />
                        </MudItem>
                    </MudGrid>
                }
            </MudTabPanel>

            <MudTabPanel Text="Import Excel">
                <div class="d-flex align-center gap-3 mb-3">
                    <MudSwitch T="bool" @bind-Value="_hasImport" Color="Color.Primary" Label="Enable import process" />
                </div>
                @if (_hasImport)
                {
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_import.ScreenMenuImportExcelProcessId" Label="Import Process ID" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="8">
                            <MudTextField @bind-Value="_import.Description" Label="Description" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_import.TableName" Label="Table Name" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_import.FieldInput" Label="Field Input" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" Class="d-flex gap-3">
                            <MudCheckBox T="bool" @bind-Value="_import.WithApproval" Label="With Approval" Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="_import.IsActive" Label="Active" Color="Color.Primary" />
                        </MudItem>
                    </MudGrid>
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(_ => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="@(_ => SaveAsync())">
            @(_saving ? "Saving..." : "Send for Approval")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public ScreenMenuEditDto? Screen { get; set; }

    private ScreenMenuEditDto _model = new();
    private ScreenMenuChildEditDto _child = new();
    private ScreenMenuImportEditDto _import = new();
    private bool _hasChild;
    private bool _hasImport;
    private bool _saving;

    private bool IsEdit => Screen != null;

    protected override void OnInitialized()
    {
        if (Screen == null)
        {
            return;
        }

        _model = Screen;
        if (Screen.Child != null)
        {
            _hasChild = true;
            _child = Screen.Child;
        }

        if (Screen.Import != null)
        {
            _hasImport = true;
            _import = Screen.Import;
        }
    }

    private async Task SaveAsync()
    {
        _model.Child = _hasChild ? _child : null;
        _model.Import = _hasImport ? _import : null;
        _model.ScreenMenuChildId = _hasChild ? _child.ScreenMenuChildId : null;
        _model.ScreenMenuImportExcelProcessId = _hasImport ? _import.ScreenMenuImportExcelProcessId : null;

        _saving = true;
        try
        {
            var result = await ScreenMenuApi.StageAsync(_model);
            if (result.Success)
            {
                Snackbar.Add(result.Message ?? "Sent for approval.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Message ?? "Save failed.", Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
